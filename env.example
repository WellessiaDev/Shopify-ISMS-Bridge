# --- Shopify ---
SHOP=wellessia
CLIENT_ID=
CLIENT_SECRET=
# Optional: only set this if it differs from CLIENT_SECRET (Shopify custom-app
# webhook signing secrets are usually the same as the app's client secret,
# but some setups use a separate value shown when you create the webhook).
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07

# --- SSL Wireless SMS Plus (Dynamic SMS) API ---
SSL_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms/dynamic
SSL_API_TOKEN=
SSL_SID=

# --- Optional: custom message text ---
# Placeholders: {{name}} {{order_number}} {{items}} {{total}} {{currency}}
MSG_ORDER_CREATED=Hi {{name}}, your order #{{order_number}} ({{items}}) worth {{currency}} {{total}} has been placed successfully. Thank you for shopping with us!
